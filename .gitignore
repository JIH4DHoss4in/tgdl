# Local secrets, diagnostics, and temporary files
.env*
!.env.example
*.log
*.stackdump
*.tmp

# Cargo registry extraction metadata retained only in local vendor copies
/vendor/**/.cargo-ok
/vendor/**/.cargo_vcs_info.json
/vendor/**/Cargo.toml.orig

# Test and coverage output
/.coverage/
/coverage/
lcov.info
*.profraw

